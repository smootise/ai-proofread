# Backend URL — change this to your TrueNAS host when moving the backend off Windows
PROOFREADER_API_URL=http://localhost:8000

# Ollama configuration — ensure the model is pulled: ollama pull gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# SQLite database path (relative to the server working directory)
DATABASE_URL=sqlite:///./data/proofreader.db

# Text length bounds (characters)
MIN_CHARS=3
MAX_CHARS=5000

# Timeouts
REQUEST_TIMEOUT_SECONDS=30
CLIPBOARD_TIMEOUT_SECONDS=0.5
PASTE_RESTORE_DELAY_MS=150

# Set to false to omit full text from the database (keeps only metadata)
STORE_FULL_TEXT=true

# V2.5 review popup window size (pixels)
REVIEW_POPUP_WIDTH=800
REVIEW_POPUP_HEIGHT=700
